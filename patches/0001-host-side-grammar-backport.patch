+/// Structured requests alone take a serial, host-masked draw; ordinary draws are unchanged.
+fn drawStream(gpa: std.mem.Allocator, row: []const f32, position: u64, s: *lanes.Stream) !u32 {
+    const constraint = s.constraint orelse return draw(row, position, s.sampling);
