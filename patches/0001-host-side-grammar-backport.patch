diff --git a/zig/src/core/lanes/grammar.zig b/zig/src/core/lanes/grammar.zig
new file mode 100644
index 00000000..3b3e0531
--- /dev/null
+++ b/zig/src/core/lanes/grammar.zig
@@ -0,0 +1,146 @@
+//! Hybrid structured decoding, adapted from TensorFold 20ad778's core/lanes/grammar.zig.
+//! Uses the same xgrammar C ABI, but intentionally supports serial structured requests only.
+//! Ordinary requests keep the original sampler and speculative fast path.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+pub const Kind = enum(u8) { json, json_schema, regex, choice, grammar };
+const Fns = struct {
+    open: *const fn ([*]const u8, usize, c_int, [*]const i32, c_int, [*]u8, usize) callconv(.c) ?*anyopaque,
+    close: *const fn (*anyopaque) callconv(.c) void,
+    words: *const fn (*anyopaque) callconv(.c) c_int,
+    compile: *const fn (*anyopaque, c_int, [*]const u8, usize, [*]u8, usize) callconv(.c) ?*anyopaque,
+    free: *const fn (*anyopaque) callconv(.c) void,
+    matcher: *const fn (*anyopaque) callconv(.c) ?*anyopaque,
+    matcher_free: *const fn (*anyopaque) callconv(.c) void,
+    accept: *const fn (*anyopaque, i32) callconv(.c) c_int,
+    terminated: *const fn (*anyopaque) callconv(.c) c_int,
+    fill: *const fn (*anyopaque, [*]i32, c_int) callconv(.c) c_int,
+};
+/// The upstream-compatible ABI, also used by host-only matcher stand-ins.
+pub const Library = Fns;
+var loaded: ?Fns = null;
+var mutex: std.atomic.Mutex = .unlocked;
+
+fn load(io: std.Io, a: Allocator) !Fns {
+    while (!mutex.tryLock()) std.atomic.spinLoopHint();
+    defer mutex.unlock();
+    if (loaded) |f| return f;
+    const exe = try std.process.executableDirPathAlloc(io, a);
+    defer a.free(exe);
+    const name = if (@import("builtin").os.tag == .macos) "libtfgrammar.dylib" else "libtfgrammar.so";
+    const installed = try std.fs.path.join(a, &.{ exe, "..", "lib", name });
+    defer a.free(installed);
+    // Keep the library mapped for the process lifetime; its callbacks outlive Compiler.open.
+    var dl = std.DynLib.open(installed) catch (std.DynLib.open(name) catch return error.NoGrammarLibrary);
+    var f: Fns = undefined;
+    const info = @typeInfo(Fns).@"struct";
+    inline for (info.field_names, info.field_types) |field, T| {
+        @field(f, field) = dl.lookup(T, "tfg_" ++ field) orelse {
+            dl.close();
+            return error.MissingGrammarSymbol;
+        };
+    }
+    loaded = f;
+    return f;
+}
+
+pub const Compiler = struct {
+    f: Fns,
+    handle: *anyopaque,
+    words: usize,
+    mutex: std.Io.Mutex = .init,
+
+    pub fn open(io: std.Io, a: Allocator, tokenizer: []const u8, vocab: u32, stops: []const u32) !Compiler {
+        const f = try load(io, a);
+        var message: [512]u8 = @splat(0);
+        const h = f.open(tokenizer.ptr, tokenizer.len, @intCast(vocab), @ptrCast(stops.ptr), @intCast(stops.len), &message, message.len) orelse return error.GrammarSetup;
+        errdefer f.close(h);
+        const words = f.words(h);
+        if (words <= 0 or @as(u32, @intCast(words)) != (vocab + 31) / 32) return error.GrammarVocabularyMismatch;
+        return .{ .f = f, .handle = h, .words = @intCast(words) };
+    }
+
+    pub fn close(c: *Compiler) void {
+        c.f.close(c.handle);
+    }
+
+    fn compile(c: *Compiler, io: std.Io, kind: Kind, text: []const u8) !*anyopaque {
+        if (text.len > 64 << 10) return error.GrammarTooLarge;
+        c.mutex.lockUncancelable(io);
+        defer c.mutex.unlock(io);
+        var message: [512]u8 = @splat(0);
+        return c.f.compile(c.handle, @backingInt(kind), text.ptr, text.len, &message, message.len) orelse return error.InvalidGrammar;
+    }
+
+    /// Run before streaming headers; malformed or unsupported grammars must fail closed.
+    pub fn validate(c: *Compiler, io: std.Io, kind: Kind, text: []const u8) !void {
+        const compiled = try c.compile(io, kind, text);
+        c.f.free(compiled);
+    }
+
+    pub fn constraint(c: *Compiler, a: Allocator, io: std.Io, kind: Kind, text: []const u8, after: ?u32) !*Constraint {
+        const compiled = try c.compile(io, kind, text);
+        defer c.f.free(compiled);
+        const matcher = c.f.matcher(compiled) orelse return error.GrammarSetup;
+        errdefer c.f.matcher_free(matcher);
+        const bits = try a.alloc(u32, c.words);
+        errdefer a.free(bits);
+        const out = try a.create(Constraint);
+        out.* = .{ .f = c.f, .handle = matcher, .bits = bits, .after = after, .active = after == null };
+        return out;
+    }
+};
+
+pub const Constraint = struct {
+    f: Fns,
+    handle: *anyopaque,
+    bits: []u32,
+    after: ?u32,
+    active: bool,
+
+    pub fn deinit(c: *Constraint, a: Allocator) void {
+        c.f.matcher_free(c.handle);
+        a.free(c.bits);
+        a.destroy(c);
+    }
+
+    /// Null only during the unconstrained reasoning block; never after grammar completion.
+    pub fn next(c: *Constraint) !?[]const u32 {
+        if (!c.active) return null;
+        if (c.f.terminated(c.handle) != 0) return error.GrammarAlreadyComplete;
+        if (c.f.fill(c.handle, @ptrCast(c.bits.ptr), @intCast(c.bits.len)) != 0) return error.GrammarMask;
+        for (c.bits) |word| if (word != 0) return c.bits;
+        return error.GrammarDeadEnd;
+    }
+
+    pub fn follow(c: *Constraint, token: u32) !void {
+        if (!c.active) {
+            c.active = token == c.after.?;
+            return;
+        }
+        if (c.f.accept(c.handle, @intCast(token)) != 1) return error.InadmissibleGrammarToken;
+    }
+};
+
+/// Host-only reference path: apply before greedy or keyed sampling, never after token selection.
+pub fn maskLogits(logits: []f32, bits: []const u32) !void {
+    if (bits.len < (logits.len + 31) / 32) return error.GrammarVocabularyMismatch;
+    var any = false;
+    for (logits, 0..) |*value, token| {
+        const allowed = (bits[token / 32] & (@as(u32, 1) << @as(u5, @intCast(token % 32)))) != 0;
+        if (!allowed) value.* = -std.math.inf(f32) else any = true;
+    }
+    if (!any) return error.GrammarDeadEnd;
+}
+
+test "mask permits only allowed vocabulary positions and refuses an empty mask" {
+    var row = [_]f32{ 100, 2, 3, 200 };
+    try maskLogits(&row, &.{0b0110});
+    try std.testing.expectEqual(-std.math.inf(f32), row[0]);
+    try std.testing.expectEqual(@as(f32, 2), row[1]);
+    try std.testing.expectEqual(@as(f32, 3), row[2]);
+    try std.testing.expectEqual(-std.math.inf(f32), row[3]);
+    try std.testing.expectError(error.GrammarDeadEnd, maskLogits(&row, &.{0}));
+    try std.testing.expectError(error.GrammarVocabularyMismatch, maskLogits(&row, &.{}));
+}
diff --git a/zig/src/core/lanes/grammar_test.zig b/zig/src/core/lanes/grammar_test.zig
new file mode 100644
index 00000000..1a52564b
--- /dev/null
+++ b/zig/src/core/lanes/grammar_test.zig
@@ -0,0 +1,99 @@
+//! Host-only matcher lifetime, isolation, reasoning transition, and fail-closed checks.
+const std = @import("std");
+const grammar = @import("grammar.zig");
+const a = std.testing.allocator;
+
+const Fake = struct {
+    plan: []const u32,
+    at: usize = 0,
+    freed: bool = false,
+
+    fn accept(ptr: *anyopaque, token: i32) callconv(.c) c_int {
+        const f: *Fake = @ptrCast(@alignCast(ptr));
+        if (f.at == f.plan.len or token < 0 or f.plan[f.at] != @as(u32, @intCast(token))) return 0;
+        f.at += 1;
+        return 1;
+    }
+    fn terminated(ptr: *anyopaque) callconv(.c) c_int {
+        const f: *Fake = @ptrCast(@alignCast(ptr));
+        return if (f.at == f.plan.len) 1 else 0;
+    }
+    fn fill(ptr: *anyopaque, words: [*]i32, n: c_int) callconv(.c) c_int {
+        const f: *Fake = @ptrCast(@alignCast(ptr));
+        const bits: [*]u32 = @ptrCast(words);
+        @memset(bits[0..@intCast(n)], 0);
+        if (f.at == f.plan.len) return -1;
+        const token = f.plan[f.at];
+        bits[token / 32] |= @as(u32, 1) << @as(u5, @intCast(token % 32));
+        return 0;
+    }
+    fn free(ptr: *anyopaque) callconv(.c) void {
+        const f: *Fake = @ptrCast(@alignCast(ptr));
+        f.freed = true;
+    }
+
+    fn constraint(f: *Fake, after: ?u32) !*grammar.Constraint {
+        // These are the only C callbacks Constraint uses. Compiler's callbacks are never invoked here.
+        var library: grammar.Library = undefined;
+        library.accept = accept;
+        library.terminated = terminated;
+        library.fill = fill;
+        library.matcher_free = free;
+        const bits = try a.alloc(u32, 2);
+        errdefer a.free(bits);
+        const c = try a.create(grammar.Constraint);
+        c.* = .{ .f = library, .handle = f, .bits = bits, .after = after, .active = after == null };
+        return c;
+    }
+};
+
+test "a rejected token leaves the grammar unchanged; completion never unmasks" {
+    var fake: Fake = .{ .plan = &.{ 1, 33, 2 } };
+    const c = try fake.constraint(null);
+    defer c.deinit(a);
+    try std.testing.expectEqual(@as(u32, 2), (try c.next()).?[0]);
+    try std.testing.expectError(error.InadmissibleGrammarToken, c.follow(0));
+    try std.testing.expectEqual(@as(usize, 0), fake.at);
+    try c.follow(1);
+    try std.testing.expectEqual(@as(u32, 2), (try c.next()).?[1]);
+    try c.follow(33);
+    try std.testing.expectEqual(@as(u32, 4), (try c.next()).?[0]);
+    try c.follow(2);
+    try std.testing.expectError(error.GrammarAlreadyComplete, c.next());
+}
+
+test "reasoning stays unconstrained until the close token and does not feed that token into JSON" {
+    var fake: Fake = .{ .plan = &.{ 1, 2 } };
+    const c = try fake.constraint(55);
+    try std.testing.expectEqual(@as(?[]const u32, null), try c.next());
+    try c.follow(7);
+    try std.testing.expect(!c.active);
+    try c.follow(55);
+    try std.testing.expect(c.active);
+    try std.testing.expectEqual(@as(usize, 0), fake.at);
+    try std.testing.expectEqual(@as(u32, 2), (try c.next()).?[0]);
+    c.deinit(a);
+    try std.testing.expect(fake.freed);
+}
+
+test "interleaved requests have independent matchers" {
+    var first: Fake = .{ .plan = &.{ 1, 33, 2 } };
+    var second: Fake = .{ .plan = &.{ 33, 1, 2 } };
+    const c1 = try first.constraint(null);
+    defer c1.deinit(a);
+    const c2 = try second.constraint(null);
+    defer c2.deinit(a);
+    try c1.follow(1);
+    try std.testing.expectEqual(@as(usize, 1), first.at);
+    try std.testing.expectEqual(@as(usize, 0), second.at);
+    try std.testing.expectEqual(@as(u32, 2), (try c2.next()).?[1]);
+    try std.testing.expectError(error.InadmissibleGrammarToken, c2.follow(1));
+    try c2.follow(33);
+    try std.testing.expectEqual(@as(u32, 2), (try c2.next()).?[0]);
+    try std.testing.expectEqual(@as(u32, 2), (try c1.next()).?[1]);
+}
+
+test "padding-only masks cannot select an out-of-vocabulary token" {
+    var row = [_]f32{ 1, 2, 3, 4 };
+    try std.testing.expectError(error.GrammarDeadEnd, grammar.maskLogits(&row, &.{@as(u32, 1) << 31}));
+}
